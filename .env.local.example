# 이 파일을 .env.local로 복사한 뒤 값을 채웁니다. .env*는 gitignore 대상입니다.

# Supabase — 필수. 없으면 lib/supabase-server.ts에서 throw하고 앱이 뜨지 않습니다.
# Supabase 대시보드 > Project Settings > API 에서 확인합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI — 선택. 없으면 AI 스토리/Recap/REMADE 시안이 규칙 기반 결과로 대체됩니다.
# NEXT_PUBLIC_ 접두사를 붙이면 브라우저 번들에 키가 실립니다. 절대 붙이지 마세요.
OPENAI_API_KEY=
